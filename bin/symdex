#!/bin/sh
# Run symdex. The first call (and any call after a source or build change)
# stages it with sbt into target/symdex; every other call is plain java.
#   bin/symdex serve --root /path/to/project      (an MCP server on stdio)
#   bin/symdex references query=Bulk.joinSorted callers=true
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
staged="$here/target/symdex/bin/symdex"
if [ ! -x "$staged" ] || [ -n "$(find "$here/build.sbt" "$here/src/main" "$here/okay/okay-mcp/src/main" \
      -newer "$staged" -type f 2>/dev/null | head -1)" ]; then
  (cd "$here" && sbt -batch --error stage >&2)
fi
exec "$staged" "$@"
