#!/bin/sh
# Claude Code PostToolUse hook (matcher "Bash|Grep"): a large search or
# test output becomes an exact digest, the whole output archived in
# .symdex/archive. Small outputs never start a JVM: they are passed by
# size here, before anything else runs.
input=$(cat)
[ ${#input} -lt 12000 ] && exit 0
here=$(cd "$(dirname "$0")/.." && pwd)
printf '%s' "$input" | exec "$here/bin/symdex" hook
